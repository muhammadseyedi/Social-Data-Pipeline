# Telegram API credentials: https://my.telegram.org
TG_API_ID=0
TG_API_HASH=
TG_SESSION_STR=
TG_CHANNEL_USERNAME=@FarasatApplyAcademy

# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=SocialDataDB
SQL_DRIVER={ODBC Driver 17 for SQL Server}
SQL_TRUSTED=1
SQL_UID=
SQL_PWD=

# LinkedIn (only if using LinkedIn scraping)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# OCR (install Tesseract separately if using OCR)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=

# NLP and runtime
SPACY_MODEL=en_core_web_sm
USE_SPACYTEXTBLOB=0
SELENIUM_HEADLESS=1
SCRAPE_INTERVAL=300
PROCESS_INTERVAL=120
LOG_LEVEL=INFO
# Optional: MEDIA_DIR=./media
